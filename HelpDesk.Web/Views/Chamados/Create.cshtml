@model HelpDesk.Web.Models.Chamado

@{
    ViewData["Title"] = "Novo chamado";
}

<h1>Novo chamado</h1>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Titulo" class="form-label">Título</label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descricao" class="form-label">Descrição</label>
        <textarea asp-for="Descricao" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Descricao" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Categoria" class="form-label">Categoria</label>
        <select asp-for="Categoria" class="form-select">
            <option value="Baixa">Hardware</option>
            <option value="Media">Software (Sistema)</option>
            <option value="Alta">Rede</option>
            <option value="Urgente">Atualização Software</option>
        </select>
        <span asp-validation-for="Categoria" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="Prioridade" class="form-label">Prioridade</label>
        <select asp-for="Prioridade" class="form-select">
            <option value="Baixa">Baixa</option>
            <option value="Media">Média</option>
            <option value="Alta">Alta</option>
            <option value="Urgente">Urgente</option>
        </select>
        <span asp-validation-for="Prioridade" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>