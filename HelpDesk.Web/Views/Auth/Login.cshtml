@{
    ViewData["Title"] = "Login";
}

<h1>Login</h1>

<div class="alert alert-info">
    Tela de login criada. Na próxima etapa vamos implementar a autenticação.
</div>

<form method="post">
    <div class="mb-3">
        <label for="email" class="form-label">E-mail</label>
        <input name="email" id="email" class="form-control" type="email" />
    </div>

    <div class="mb-3">
        <label for="senha" class="form-label">Senha</label>
        <input name="senha" id="senha" class="form-control" type="password" />
    </div>

    <button type="submit" class="btn btn-primary">Entrar</button>
    <a asp-controller="Auth" asp-action="Registrar" class="btn btn-secondary">Criar conta</a>
</form>